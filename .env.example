# Copy to .env and fill in. Never commit .env.
# DeepSeek handles LLM calls; Gemini is still used for embeddings.
DEEPSEEK_API_KEY=your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENALEX_API_KEY=
# Batched OpenAlex author-metrics enrichment (h-index and author citations).
# Requires OPENALEX_API_KEY. The key is free; see openalex.org/settings/api.
# WHACK26_RESEARCH_METRICS_ENABLED=1

# Optional / fallback providers and sources
HF_TOKEN=
ZENODO_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
JINA_API_KEY=
S2_API_KEY=
DATAGOV_API_KEY=
KAGGLE_API_TOKEN=

# Provider selection
# LLM: deepseek | gemini | cloudflare | mock
# Embeddings: gemini | local | mock (DeepSeek has no embeddings API)
WHACK26_LLM_PROVIDER=deepseek
WHACK26_EMBED_PROVIDER=gemini

# Model overrides
# DEEPSEEK_MODEL=deepseek-flash
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Defaults
WHACK26_OFFLINE=0
WHACK26_LOG_LEVEL=INFO
WHACK26_HTTP_TIMEOUT=20
WHACK26_LLM_TIMEOUT=60
WHACK26_EMBED_TIMEOUT=30

# Field-classification thresholds (optional; these are the defaults)
WHACK26_TOP_K=10
WHACK26_DUPLICATE_COSINE=0.90
WHACK26_REFINE_CONFIDENCE=0.62
WHACK26_MAX_DEPTH=4
WHACK26_DESC_WEIGHT=0.5
WHACK26_CENTROID_WEIGHT=0.5

# Factor mapping (optional)
WHACK26_FACTOR_MAP_COSINE=0.72

# Field-specific pitfalls (opt-in; adversarial literature search per field)
WHACK26_FIELD_PITFALLS_ENABLED=0
WHACK26_FIELD_PITFALLS_MAX_QUERIES_PER_FIELD=1
WHACK26_FIELD_PITFALLS_RECORDS_PER_QUERY=5
WHACK26_FIELD_PITFALLS_MAX_PER_FIELD=3
WHACK26_FIELD_PITFALLS_MAX_TOTAL=12

# Semantic scraping (opt-in; defaults shown)
# WHACK26_SCRAPE_ENABLED=0
# WHACK26_SCRAPE_MAX_DEPTH=2
# WHACK26_SCRAPE_MAX_RESOURCES=100
# WHACK26_SCRAPE_MAX_LINKS_PER_RESOURCE=25
# WHACK26_SCRAPE_MAX_FETCHES=100
# WHACK26_SCRAPE_SUMMARY_THRESHOLD=0.62
# WHACK26_SCRAPE_LINK_THRESHOLD=0.68
# WHACK26_SCRAPE_CREDIBILITY_THRESHOLD=0.50
# WHACK26_SCRAPE_TTL_DAYS=7
# WHACK26_SCRAPE_METHOD_VERSION=1.0.0
# WHACK26_SCRAPE_USER_AGENT=whack26-research/0.1 (https://github.com/hoisin-sauce/whack-26)

# Compliant HTTP fetcher (opt-in; defaults shown)
# WHACK26_SCRAPE_FETCH_ENABLED=0
# WHACK26_SCRAPE_ALLOWED_DOMAINS=
# WHACK26_SCRAPE_BLOCKED_DOMAINS=
# WHACK26_SCRAPE_RATE_LIMIT_SECONDS=1.0
# WHACK26_SCRAPE_MAX_BYTES=2000000
# WHACK26_SCRAPE_MAX_TEXT_CHARS=4000
# WHACK26_SCRAPE_FETCH_TIMEOUT=15.0
# WHACK26_SCRAPE_MAX_REDIRECTS=3
# WHACK26_SCRAPE_ALLOW_PRIVATE_NETWORKS=0

# Optional path overrides
# WHACK26_BASE_DIR=.
# WHACK26_CACHE_DIR=cache
# WHACK26_RUNS_DIR=runs
# WHACK26_DATA_DIR=data
# WHACK26_CORPUS_PATH=docs/corpus/statistical-pitfalls.md

# ---------------------------------------------------------------------------
# Agentic / model-search stages (opt-in; defaults shown)
# Wired into `run`; equivalent flags: --model-search, --variants,
# --validate-generation, and --collection-json/--collection-field.
# `run --full` enables scraping, model search, variants, generation validation,
# and statistical validation together.
# ---------------------------------------------------------------------------
# WHACK26_MODEL_SEARCH_ENABLED=0
# WHACK26_MODEL_SEARCH_FOLDS=3
# WHACK26_MODEL_SEARCH_TEST_FRACTION=0.30
# WHACK26_MODEL_SEARCH_FINAL_HOLDOUT_FRACTION=0.20
# WHACK26_MODEL_SEARCH_MAX_CANDIDATES=100
# WHACK26_MODEL_SEARCH_TOP_N=5
# WHACK26_MODEL_SEARCH_SEED=0
# core = numpy/scipy only; sklearn adds trees/forest/boosting; full also SINDy.
# scikit-learn and pysindy are in requirements.txt; statsmodels is optional.
# WHACK26_MODEL_SEARCH_BACKEND=core
# WHACK26_VARIANTS_ENABLED=0
# WHACK26_GENERATION_VALIDATION_ENABLED=0

# Agent loop (opt-in; wired into `run` when enabled)
# WHACK26_AGENT_LOOP_ENABLED=0
# WHACK26_AGENT_MAX_ATTEMPTS_PER_FAMILY=6
# WHACK26_AGENT_MAX_TOTAL_ATTEMPTS=18
# WHACK26_AGENT_MAX_SECONDS=900

# Statistical backend selection (parsed and validated; not yet consumed by the
# run/validation pipeline, which still defaults to the four-layer engine)
# WHACK26_STATISTICAL_BACKEND=auto
# WHACK26_EXTERNAL_VALIDATOR=

# Final model judge (advisory; writes final_judge.json/.md/.html and the
# UI fragment). `run --judge` enables it for one run.
# WHACK26_FINAL_JUDGE_ENABLED=0
# WHACK26_FINAL_JUDGE_MODEL=
# WHACK26_FINAL_JUDGE_DA_MODEL=
# WHACK26_FINAL_JUDGE_MAX_WORKERS=3
# WHACK26_FINAL_JUDGE_MAX_TOKENS=2000
# WHACK26_FINAL_JUDGE_MIN_EVALUATED_FRACTION=0.50

# Hierarchy placement and thresholds. Placement is used for scraped research
# documents; the dataset classifier still uses create/assign by default.
# WHACK26_HIERARCHY_PLACEMENT_ENABLED=1
# WHACK26_HIERARCHY_TAU_1=0.55
# WHACK26_HIERARCHY_TAU_2=0.60
# WHACK26_HIERARCHY_TAU_3=0.65
# WHACK26_HIERARCHY_TAU_4=0.70
# WHACK26_SPECIFICITY_MARGIN=0.05
# WHACK26_PROMOTION_MARGIN=0.05
# WHACK26_MAX_ROOTS=20
# WHACK26_MAX_CHILDREN=20
